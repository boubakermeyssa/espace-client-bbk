# ========================================================
# CONFIGURATION ESPACE CLIENT BBK — VARIABLES PRODUCTION
# ========================================================

# Environnement d'exécution ('production' ou 'development')
NODE_ENV=production

# Port du serveur Express (par défaut 3000 ou fourni par l'hébergeur)
PORT=3000

# Clé de chiffrement des cookies de session (générer une chaîne aléatoire sécurisée)
SESSION_SECRET=votre_cle_secrete_ultra_securisee_bbk_2026

# ========================================================
# INTÉGRATION AIRTABLE (OBLIGATOIRE EN PRODUCTION)
# ========================================================
# Personal Access Token Airtable avec droits 'data.records:read' et 'data.records:write'
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Identifiant de la base Airtable (commence par 'app...')
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ========================================================
# ACCÈS BACK-OFFICE AGENCE (ADMINISTRATION)
# ========================================================
# Identifiants de connexion réservés à l'équipe de l'agence
ADMIN_EMAIL=contact@agence-bbk.fr
ADMIN_PASSWORD=ChangerCeMotDePasseComplex2026!
